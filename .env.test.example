# Integration tests only (`npm run test:integration`).
# Copy to `.env.test` — it is gitignored.
#
# `npm test` (unit) needs NONE of this: it never touches a database.
#
# The database name MUST contain "test". The suite truncates every table
# between tests and refuses to start against a name that doesn't say so.

# Option A — the project's docker-compose PostgreSQL (POSTGRES_PORT in .env,
# 5433 by default). Create the database once:
#   docker compose up -d postgres
#   docker compose exec postgres createdb -U postgres foodlify_test
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5433/foodlify_test

# Option B — any PostgreSQL 17 you already have:
#   createdb -h localhost -p 5432 -U postgres foodlify_test
# DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/foodlify_test

# Option C — no server handy, and PostgreSQL's binaries are installed: start a
# throwaway instance on a spare port, no admin rights and nothing to clean up
# but a directory.
#   initdb -D ./tmp/pgdata -U postgres --auth=trust
#   pg_ctl -D ./tmp/pgdata -l ./tmp/pg.log -o "-p 5455" start
#   createdb -h localhost -p 5455 -U postgres foodlify_test
# DATABASE_URL_TEST=postgresql://postgres@localhost:5455/foodlify_test
