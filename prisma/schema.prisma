generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════
// Users & Access Control
// ═══════════════════════════════════════════════════════════════

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id    String @id @default(cuid())
  name  String
  email String @unique
  /// Hashed password (bcrypt). Never returned in any API response.
  password String
  /// Account role — CUSTOMER for storefront users, ADMIN for dashboard.
  role     Role   @default(CUSTOMER)

  customer      Customer?
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One row per issued refresh token (multi-device sessions). Only the SHA-256
/// hash is stored — a DB leak never exposes usable tokens. Rotation revokes the
/// presented token and inserts its successor; logout revokes just that session.
model RefreshToken {
  id        String   @id @default(cuid())
  /// SHA-256 hash of the refresh JWT (see jwt.helper `hashToken`).
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

/// Email verification codes. Only the bcrypt hash of the 6-digit code is
/// stored; codes expire after a short window and are single-use.
model Otp {
  id       String @id @default(cuid())
  email    String
  /// bcrypt hash of the 6-digit code — the plaintext is only ever emailed.
  codeHash String
  /// What the code proves: "registration" | "password_reset".
  purpose  String
  used     Boolean @default(false)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

model Customer {
  id     String @id @default(cuid())
  userId String @unique
  /// Contact phone — required and unique per customer.
  phone  String @unique

  cart      Cart?
  addresses Address[]
  orders    Order[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id           String  @id @default(cuid())
  customerId   String
  addressLine1 String
  addressLine2 String?
  city         String
  postalCode   String
  country      String

  orders Order[]

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

// ═══════════════════════════════════════════════════════════════
// Restaurants & Menus
// ═══════════════════════════════════════════════════════════════

model Restaurant {
  id   String @id @default(cuid())
  name String

  menus  Menu[]
  carts  Cart[]
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Menu {
  id           String @id @default(cuid())
  name         String
  restaurantId String

  menuItems MenuItem[]

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

model MenuItem {
  id     String  @id @default(cuid())
  menuId String
  name   String
  price  Decimal

  cartItems  CartItem[]
  orderItems OrderItems[]
  menu       Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuId])
}

// ═══════════════════════════════════════════════════════════════
// Cart
// ═══════════════════════════════════════════════════════════════

model Cart {
  id           String @id @default(cuid())
  customerId   String @unique
  restaurantId String

  cartItems CartItem[]

  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

model CartItem {
  id         String  @id @default(cuid())
  cartId     String
  menuItemId String
  quantity   Int
  price      Decimal
  name       String

  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, menuItemId])
  @@index([cartId])
  @@index([menuItemId])
}

// ═══════════════════════════════════════════════════════════════
// Orders
// ═══════════════════════════════════════════════════════════════

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Order {
  id           String      @id @default(cuid())
  customerId   String
  addressId    String
  restaurantId String
  orderDate    DateTime    @default(now())
  /// Current effective status — mirrors the latest entry in `timeline` for
  /// fast indexed queries (e.g. "list all PENDING orders").
  status       OrderStatus @default(PENDING)
  /// Snapshot of the order total at checkout time — frozen at order creation
  /// and never recomputed from OrderItems. Survives later price changes.
  totalAmount  Decimal
  /// Append-only event log capturing status transitions and delivery tracking
  /// updates as a single chronological stream. Each entry shape:
  /// { status, changedAt, changedBy?, location?, estimatedDeliveryTime? }
  timeline     Json        @default("[]")

  orderItems   OrderItems[]
  transactions Transaction[]

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  address    Address     @relation(fields: [addressId], references: [id], onDelete: Restrict)
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([addressId])
  @@index([restaurantId])
  @@index([status])
  @@index([customerId, createdAt(sort: Desc)])
}

model OrderItems {
  id         String  @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int
  /// Snapshot of menu item price at order time — never updated even if MenuItem.price changes later
  price      Decimal
  /// Snapshot of menu item name at order time — never updated even if MenuItem.name changes later
  name       String

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([menuItemId])
}

// ═══════════════════════════════════════════════════════════════
// Payments / Transactions
// ═══════════════════════════════════════════════════════════════

enum TransactionType {
  ORDER_PAYMENT
  REFUND
  PARTIAL_REFUND
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  PAYPAL
  WALLET
}

/// Generic financial transaction record. Supports order payments, refunds,
/// and external gateway integrations (Stripe, PayPal, etc.). The optional
/// orderId allows future non-order transactions (wallet top-ups, etc.).
model Transaction {
  id             String          @id @default(cuid())
  type           TransactionType
  amount         Decimal
  currency       String          @default("EGP")
  status         TransactionStatus
  paymentMethod  PaymentMethod
  /// Internal system financial reference number, separate from external gateway IDs
  internalTxNumber String       @unique
  externalRef    String?
  orderId        String?
  metadata       Json?

  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([externalRef])
}
