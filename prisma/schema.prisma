generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"

  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}


enum Role {
  CUSTOMER
  ADMIN
  RESTAURANT
}

model User {
  id    String @id @default(cuid())
  name  String
  email String @unique
  password String?
  googleId String? @unique
  role     Role   @default(CUSTOMER)
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)

  customer      Customer?
  refreshTokens RefreshToken[]
  ownedRestaurants Restaurant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Otp {
  id       String @id @default(cuid())
  email    String
  codeHash String
  purpose  String
  used     Boolean @default(false)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

model Customer {
  id     String @id @default(cuid())
  userId String @unique
  phone  String? @unique

  cart              Cart?
  addresses         Address[]
  orders            Order[]
  rates             RestaurantRate[]
  preferredPayments PreferredPaymentSetting[]
  supportTickets    SupportTicket[]
  pushSubscriptions PushSubscription[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id           String  @id @default(cuid())
  customerId   String
  addressLine1 String
  addressLine2 String?
  city         String
  postalCode   String
  country      String
  isDefault    Boolean @default(false)

  orders Order[]

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model PreferredPaymentSetting {
  id         String        @id @default(cuid())
  customerId String
  method     PaymentMethod
  isDefault  Boolean       @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, method])
  @@index([customerId])
}

model PushSubscription {
  id         String @id @default(cuid())
  customerId String
  endpoint   String @unique
  p256dh     String
  auth       String
  userAgent  String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}


model Restaurant {
  id   String @id @default(cuid())
  name String
  isDeleted Boolean @default(false)
  createdBy String?
  updatedBy String?
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  menus   Menu[]
  carts   Cart[]
  orders  Order[]
  rates   RestaurantRate[]
  details RestaurantDetails?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model RestaurantDetails {
  id           String @id @default(cuid())
  restaurantId String @unique
  phone        String
  email        String?
  description  String?

  addressLine1 String
  addressLine2 String?
  city         String
  postalCode   String
  country      String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Menu {
  id           String @id @default(cuid())
  name         String
  restaurantId String
  isDeleted Boolean @default(false)
  createdBy String?
  updatedBy String?

  menuItems  MenuItem[]
  changeLogs MenuChangeLog[]

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

enum MenuChangeEntity {
  MENU
  MENU_ITEM
}

enum MenuChangeAction {
  CREATED
  UPDATED
  DELETED
  RESTORED
}

model MenuChangeLog {
  id       String           @id @default(cuid())
  menuId   String
  entity   MenuChangeEntity
  entityId String
  action   MenuChangeAction
  snapshot Json
  changedBy String?

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([menuId, createdAt(sort: Desc)])
}

model MenuItem {
  id     String  @id @default(cuid())
  menuId String
  name   String
  price  Decimal
  stock  Int?
  isDeleted Boolean @default(false)
  createdBy String?
  updatedBy String?

  cartItems  CartItem[]
  orderItems OrderItems[]
  menu       Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuId])
}


model Cart {
  id           String  @id @default(cuid())
  customerId   String? @unique
  guestToken   String? @unique
  restaurantId String

  cartItems CartItem[]

  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([updatedAt])
}

model CartItem {
  id         String  @id @default(cuid())
  cartId     String
  menuItemId String
  quantity   Int
  price      Decimal
  name       String

  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, menuItemId])
  @@index([cartId])
  @@index([menuItemId])
}


enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Order {
  id           String      @id @default(cuid())
  customerId   String
  addressId    String
  restaurantId String
  orderDate    DateTime    @default(now())
  status       OrderStatus @default(PENDING)
  totalAmount  Decimal
  timeline     Json        @default("[]")

  orderItems     OrderItems[]
  transactions   Transaction[]
  rate           RestaurantRate?
  supportTickets SupportTicket[]

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  address    Address     @relation(fields: [addressId], references: [id], onDelete: Restrict)
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([addressId])
  @@index([restaurantId])
  @@index([status])
  @@index([customerId, createdAt(sort: Desc)])
}

model OrderItems {
  id         String  @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int
  price      Decimal
  name       String

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([menuItemId])
}


model RestaurantRate {
  id           String  @id @default(cuid())
  restaurantId String
  orderId      String  @unique
  customerId   String
  rating       Int
  comment      String?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([customerId])
}


enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
  ESCALATED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  ORDER_ISSUE
  PAYMENT
  DELIVERY_DELAY
  REFUND
  ACCOUNT
  OTHERS
}

model CustomerServiceEmployee {
  id              String         @id @default(cuid())
  name            String
  section         TicketCategory
  assignedTickets Int            @default(0)

  supportTickets SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id              String         @id @default(cuid())
  requestId       String         @unique
  customerId      String
  orderId         String?
  category        TicketCategory
  priority        TicketPriority @default(MEDIUM)
  status          TicketStatus   @default(OPEN)
  subject         String
  description     String
  assignedAgentId String?
  resolution      String?
  resolvedAt      DateTime?

  customer      Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedAgent CustomerServiceEmployee? @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  order         Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}


enum TransactionType {
  ORDER_PAYMENT
  REFUND
  PARTIAL_REFUND
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  PAYPAL
  WALLET
}

model Transaction {
  id             String          @id @default(cuid())
  type           TransactionType
  amount         Decimal
  currency       String          @default("EGP")
  status         TransactionStatus
  paymentMethod  PaymentMethod
  internalTxNumber String       @unique
  externalRef    String?
  orderId        String?
  metadata       Json?

  order   Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  details TransactionDetails?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([externalRef])
}

model TransactionDetails {
  id            String @id @default(cuid())
  transactionId String @unique

  gateway String?
  stage   String?

  sessionId       String?
  paymentIntentId String?
  refundId        String?

  gatewayStatus String?
  failureReason String?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentIntentId])
}

model PaymentIntegrationType {
  id String @id @default(cuid())
  code        String        @unique
  displayName String
  paymentMethod PaymentMethod
  isEnabled     Boolean       @default(true)

  configuration PaymentIntegrationConfiguration?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentIntegrationConfiguration {
  id     String @id @default(cuid())
  typeId String @unique

  currency   String  @default("EGP")
  successUrl String?
  cancelUrl  String?
  isTestMode Boolean @default(true)

  secretKeyEnvVar     String?
  webhookSecretEnvVar String?

  type PaymentIntegrationType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum AuditAction {
  CREATED
  UPDATED
  STATUS_CHANGED
}

model AuditingEvent {
  id String @id @default(cuid())
  entity   String
  entityId String
  action   AuditAction
  changes  Json?
  actorId   String?
  actorRole String?
  ip    String?
  route String?

  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt(sort: Desc)])
  @@index([entity, createdAt(sort: Desc)])
  @@index([actorId])
}
