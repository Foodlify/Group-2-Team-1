generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════
// Users & Access Control
// ═══════════════════════════════════════════════════════════════

model User {
  id    String @id @default(cuid())
  name  String
  email String @unique

  customer Customer?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String    @id @default(cuid())
  userId    String    @unique
  addresses Address[]
  cart      Cart?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id           String  @id @default(cuid())
  customerId   String
  addressLine1 String
  addressLine2 String?
  city         String
  postalCode   String
  country      String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

// ═══════════════════════════════════════════════════════════════
// Restaurants & Menus
// ═══════════════════════════════════════════════════════════════

model Restaurant {
  id    String @id @default(cuid())
  name  String
  menus Menu[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  carts     Cart[]
}

model Menu {
  id           String     @id @default(cuid())
  name         String
  restaurantId String
  items        MenuItem[]

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

model MenuItem {
  id     String  @id @default(cuid())
  menuId String
  name   String
  price  Decimal

  menu      Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuId])
}

// ═══════════════════════════════════════════════════════════════
// Cart
// ═══════════════════════════════════════════════════════════════

model Cart {
  id           String     @id @default(cuid())
  customerId   String     @unique
  restaurantId String
  items        CartItem[]

  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

model CartItem {
  id         String  @id @default(cuid())
  cartId     String
  menuItemId String
  quantity   Int
  price      Decimal
  name       String

  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, menuItemId])
  @@index([cartId])
  @@index([menuItemId])
}
