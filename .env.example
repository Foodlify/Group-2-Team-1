PORT=3000
NODE_ENV=development
JWT_SECRET=my_super_secret_key_change_in_production

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=G2T1M
POSTGRES_PORT=5433

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/G2T1M

# ── Auth (optional; sensible defaults applied) ──
# JWT_REFRESH_SECRET=separate_refresh_secret   # defaults to JWT_SECRET
# JWT_ACCESS_EXPIRES=15m
# JWT_REFRESH_EXPIRES=7d

# ── CORS (optional) ──
# Comma-separated allowed origins for browser clients (cookie auth needs this).
# Leave unset in dev to reflect the request origin.
# CORS_ORIGIN=http://localhost:3000
