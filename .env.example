PORT=3000
NODE_ENV=development
JWT_SECRET=my_super_secret_key_change_in_production

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=G2T1M
POSTGRES_PORT=5433

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/G2T1M

# ── Auth (optional; sensible defaults applied) ──
# JWT_REFRESH_SECRET=separate_refresh_secret   # defaults to JWT_SECRET
# JWT_ACCESS_EXPIRES=15m
# JWT_REFRESH_EXPIRES=7d

# ── Redis cache (optional) ──
# Unset = caching disabled, everything is served from PostgreSQL.
# With docker compose the API talks to the bundled redis service.
# REDIS_URL=redis://localhost:6379
# REDIS_PORT=6379
# REDIS_CACHE_TTL_SECONDS=300

# ── Abandoned-cart housekeeping (optional) ──
# CART_GUEST_TTL_HOURS=24
# CART_CUSTOMER_TTL_DAYS=30
# CART_SWEEP_INTERVAL_MINUTES=60   # 0 disables the background sweeper

# ── Stripe card payments (optional) ──
# Unset = CREDIT_CARD is not offered at all: it is absent from the request
# schema and from the generated OpenAPI document, and only CASH is accepted.
# Both keys are needed together — the app refuses to boot with a secret key but
# no webhook secret, because such a payment could never be confirmed.
# Test keys come from https://dashboard.stripe.com/test/apikeys and the webhook
# secret from `stripe listen` (see docs/PAYMENTS.md).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Where Stripe returns the customer after the hosted checkout page.
# STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
# STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# ── Outgoing email / SMTP (optional in dev, REQUIRED in production) ──
# Unset = messages are written to the log instead of sent, so the OTP flow
# stays usable without credentials. In production the mailer refuses to send
# and answers 503 rather than silently swallowing verification codes.
# Registration depends on this: nobody can verify an account without it.
# Anything unset here is simply not read — the names must match exactly.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587                  # 587 = STARTTLS, 465 = implicit TLS
# SMTP_USER=you@example.com
# SMTP_PASS=app_password_not_your_login_password
# MAIL_FROM=you@example.com      # falls back to SMTP_USER
#
# A personal Gmail account works for a demo but is NOT a transactional mail
# channel: Gmail answers `250 OK` and then silently discards a large share of
# app-generated mail, so nothing in the application can detect the loss. Use a
# transactional provider on a verified domain for production. See docs/EMAIL.md.

# ── Database pool (optional) ──
# Postgres connections held by this instance. Keep (instances x this) under the
# server's max_connections.
# Swept from 5 to 80 against the order-flow plan: there is a near-binary cliff
# between 8 and 10 (31% -> 100% of requests served), nothing to gain above 10,
# and a real cost for going higher — place-order p95 is 102 ms at 10, 193 ms at
# 20 and 329 ms at 80. Stay in 12..20. See docs/LOAD_TESTING.md.
# DATABASE_POOL_MAX=20

# ── Reverse proxies (optional, but REQUIRED if you run behind one) ──
# How many proxy hops to believe when working out the client's IP. The rate
# limiter counts by that IP, so this is what decides whether its limits are
# per-customer or one shared cap on the whole service.
#   0 (default) = directly exposed.
#   1           = exactly one proxy in front (nginx, a load balancer, ...).
# Getting it too LOW behind a proxy means every customer shares one bucket:
# 20 logins per 15 minutes for everybody combined. Too HIGH lets a client
# forge X-Forwarded-For and get a fresh bucket per request. Count the hops.
# TRUST_PROXY=0

# ── Logging ──
# Directory for the rotating log files. Logs always go to stdout as well, so an
# empty value is not "no logs" — it is "stdout only", which is what a container
# platform reads anyway. The production image ships with it empty.
# LOG_DIR=logs

# ── CORS (optional) ──
# Comma-separated allowed origins for browser clients (cookie auth needs this).
# Leave unset in dev to reflect the request origin.
# CORS_ORIGIN=http://localhost:3000

# ── Web Push (optional) ──
# Order-status notifications to a customer's browser. There is no provider and
# no account: these are a key pair you generate yourself, and the push goes
# straight to the endpoint the browser issued on its own vendor's service.
#
#   npx web-push generate-vapid-keys
#
# Unset means push is simply off — every other path is unchanged. Set BOTH or
# neither: a public key with no private key lets browsers subscribe and then
# never hear anything, so the app refuses to boot in that state.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# How a push service reaches whoever is sending, if something goes wrong.
# Must be a mailto: or https: URL.
# VAPID_SUBJECT=mailto:support@foodlify.example

# ── Google sign-in (optional) ──
# Social Media Authentication. Free: create an OAuth 2.0 Client ID (type "Web
# application") at https://console.cloud.google.com/apis/credentials — no
# billing account and no card.
#
# Register the callback below as an "Authorized redirect URI" on that client,
# EXACTLY as written: Google compares the string, not the resolved URL.
#
# Unset means the two routes answer 404 and the API is honest about not
# offering it. Set BOTH or neither — half-configured sends people to a consent
# screen whose callback cannot complete, so the app refuses to boot.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Where the browser lands after a successful sign-in. Unset means the callback
# answers with JSON instead — which is what makes the flow demonstrable against
# a backend with no frontend in front of it.
#
# Leaving it unset has one consequence worth knowing before you meet it: the
# browser ends up parked ON the callback URL. Reloading that page re-submits a
# `code` already spent and a `state` whose cookie was deliberately cleared, so
# the answer is a 400 — correct behaviour (both are single-use by design)
# arriving at a confusing moment. Set this and reload becomes harmless.
# GOOGLE_POST_LOGIN_REDIRECT=http://localhost:3000/demo/
